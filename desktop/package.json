{
  "name": "appian-sentinel-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Appian Sentinel standalone desktop app with an embedded Python engine sidecar.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "build:desktop": "node scripts/build-desktop-standalone.mjs && electron-builder --win --config electron-builder.yml --publish never",
    "build:installers:win": "node scripts/build-installers-win.mjs",
    "start": "electron .",
    "dist": "npm run build:installers:win",
    "test:ui": "playwright test",
    "smoke:sidecar": "python ../tools/smoke_sidecar.py"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "9.0.1",
    "cross-env": "7.0.3",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "wait-on": "8.0.0"
  }
}
