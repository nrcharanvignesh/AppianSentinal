# LiteLLM Proxy Configuration
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-your-proxy-key

# Model selection (from proxy's model list)
SENTINEL_PRIMARY_MODEL=bedrock.anthropic.claude-opus-4-8
SENTINEL_FAST_MODEL=bedrock.anthropic.claude-sonnet-5

# Application
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_WORKSPACE=./workspace
